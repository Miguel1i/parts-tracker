# Copy to apps/web/.env.local for local development. Never commit real values.
# Next.js reads only apps/web/.env.local; the db and scraper scripts read a repo-root .env first, then
# apps/web/.env.local.
# Each variable is introduced by the milestone noted next to it.

# Database (milestone 2) — local dev and CI use a SQLite file (relative paths resolve to the repo root).
# Production uses Turso: TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io plus TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Auth (milestone 5) — Better Auth, email/username + password.
# Production values go to Vercel with scripts/setup-vercel-env.sh (reads apps/web/.env.vercel).
# Session signing key, at least 32 random bytes: `openssl rand -base64 32`. Required.
BETTER_AUTH_SECRET=
# Public origin of the app. Optional: defaults to localhost, and on Vercel to the production
# domain (VERCEL_PROJECT_PRODUCTION_URL) or the preview URL.
BETTER_AUTH_URL=
# Optional: email invite links through Resend. Without a key, Admin → Users shows the link to send
# yourself (and development also prints the email to the server console).
RESEND_API_KEY=
# Sender, e.g. "Parts Tracker <noreply@your-domain>" (a domain verified in Resend).
EMAIL_FROM=

# On-demand scraping via GitHub Actions (milestone 4; used by Admin → Merchants → Test merchant)
# Fine-grained PAT limited to this repo with "Actions: read and write". Server-only; never exposed.
GH_DISPATCH_TOKEN=
# owner/name of the repo with scrape.yml. Optional on Vercel (taken from the linked Git repo).
GH_REPO=Miguel1i/parts-tracker
# Branch the dispatched workflow runs on (default main).
GH_DISPATCH_REF=

# Scraper only (GitHub secret AWIN_FEEDS; locally in .env): affiliate product feeds for shops
# whose pages are behind a bot wall. JSON of merchant slug -> Awin "Create-a-Feed" download URL
# (CSV, gzip). The URL contains your Awin API key: never commit it.
# AWIN_FEEDS={"worten":"https://productdata.awin.com/datafeed/download/apikey/…","pccomponentes-pt":"…"}
