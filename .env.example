# Copy to apps/web/.env.local for local development. Never commit real values.
# Each variable is introduced by the milestone noted next to it.

# Database (milestone 2) — local dev uses a SQLite file; production uses Turso
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Auth (milestone 5) — Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# On-demand scraping via GitHub Actions (milestone 4)
GH_DISPATCH_TOKEN=
GH_REPO=Miguel1i/parts-tracker
