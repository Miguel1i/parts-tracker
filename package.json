{
  "name": "parts-tracker",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @parts/db db:generate",
    "db:migrate": "pnpm --filter @parts/db db:migrate",
    "db:seed": "pnpm --filter @parts/db db:seed",
    "db:import-legacy": "pnpm --filter @parts/db db:import-legacy"
  },
  "devDependencies": {
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6"
  }
}
